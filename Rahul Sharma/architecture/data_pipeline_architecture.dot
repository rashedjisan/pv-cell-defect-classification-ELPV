digraph ELPV_data_pipeline {
	bgcolor=white dpi=200 nodesep=0.4 rankdir=LR ranksep=0.5 splines=ortho
	node [fontname=Arial fontsize=10 margin="0.14,0.10" shape=box style=rounded]
	src [label="Pinned ELPV source
images + labels"]
	audit [label="Integrity / count /
similarity audit"]
	target [label="0.0/1.0 endpoint
401 ambiguous excluded"]
	split [label="Frozen class × cell-type
train/val/test split"]
	prep [label="224×224 preprocessing
train-only augmentation"]
	models [label="Logistic + Custom CNN +
ResNet18 + EfficientNet-B0"]
	lock [label="Validation checkpoint +
threshold locking"]
	eval [label="Locked test + statistics +
calibration + robustness"]
	store [label="Versioned tables / figures /
models / manifest"]
	src -> audit
	audit -> target
	target -> split
	split -> prep
	prep -> models
	models -> lock
	lock -> eval
	eval -> store
}
